# packages/workstation.list — Desktop environment packages

# Sway + Wayland
sway
swaylock
swayidle
xdg-desktop-portal-wlr
xorg-xwayland

# Bar
waybar

# Wallpaper
swaybg

# Launcher
wofi

# Terminal
ghostty

# File manager (TUI)
yazi

# Notifications
mako
libnotify

# Screenshot / clipboard
grim
slurp
wl-clipboard

# Virtual keyboard input (used by sway bindgesture)
wtype

# Qt Wayland support (native rendering instead of XWayland fallback)
qt5-wayland
qt6-wayland

# Brightness / display control (both harmless when unused)
brightnessctl
ddcutil

# Authentication agent (needed for privilege escalation prompts in Sway)
polkit-gnome

# Network Manager tray icon (WiFi GUI in Sway)
network-manager-applet

# Bluetooth
bluez
bluez-utils

# Theming
adwaita-icon-theme
papirus-icon-theme
breeze-gtk
qt6ct

# Tray icon support (needed for Chrome, JB Toolbox, Dropbox, etc.)
libappindicator

# Dropbox runtime dependency (GPGME Python bindings for package signature
# verification). In extra/ — not AUR despite Dropbox itself being AUR.
python-gpgme

# WebKit rendering engine
# - 4.1: Tauri v2 apps (drawdesk), telegram-desktop link previews, other GTK3 apps
# - 6.0: GTK4 apps (future-proofing; Tauri v2 still defaults to 4.1 on most builds)
webkit2gtk-4.1
webkitgtk-6.0

# Blue light filter (Wayland-native, minimal)
wlsunset

# Clipboard history (Wayland-native, pairs with wl-clipboard)
cliphist

# Media player
mpv
yt-dlp

# Image viewer (Wayland-native, gallery mode, Sway IPC)
swayimg

# Desktop applications
obsidian
keepassxc
obs-studio
gimp
libreoffice-fresh

# Code editor
code

# Document / OCR tooling
qpdf
pandoc-cli
tesseract
tesseract-data-eng

# VPN
wireguard-tools

# Preferred VNC client (remote-viewer). GTK and Wayland-native, so it honours the
# compositor's output scale. Also pulled in by modules/virtualization.sh; listed
# here too because remote access must not depend on that module being enabled.
virt-viewer

# Fallback VNC client (vncviewer). X11-only, so under Sway it goes through
# XWayland: a scaled output is rendered at 1x then upscaled, halving the effective
# resolution of a HiDPI stream. Prefer virt-viewer. Ships a server too, but nothing
# enables it and the firewall drops 5900-5901 — tunnel over SSH to reach one.
tigervnc

# Wayland-native VNC server for Sway (headless or screen sharing). Not enabled by
# default and the firewall drops 5900-5901 — tunnel over SSH to reach it.
wayvnc

# Forward individual Wayland apps over SSH (Wayland's answer to `ssh -X`)
waypipe

# File sync / transfer (backups, mirroring, rsync-over-ssh to servers)
rsync

# Git + GitHub
openssh
github-cli
sshpass

# Communication
telegram-desktop
discord
